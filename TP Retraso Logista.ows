		<properties node_id="18" format="literal">{'auto_commit': True, 'color_by_class': True, 'controlAreaVisible': True, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x00\xef\x00\x00\x00A\x00\x00\x04\x10\x00\x00\x02@\x00\x00\x00\xf0\x00\x00\x00`\x00\x00\x04\x0f\x00\x00\x02?\x00\x00\x00\x00\x00\x00\x00\x00\x05V\x00\x00\x00\xf0\x00\x00\x00`\x00\x00\x04\x0f\x00\x00\x02?', 'select_rows': True, 'show_attribute_labels': True, 'show_distributions': False, 'stored_selection': {'rows': [], 'columns': []}, 'stored_sort': [], '__version__': 1}</properties>
		<properties node_id="19" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x01\x1a\x00\x00\x00M\x00\x00\x04;\x00\x00\x02l\x00\x00\x01\x1b\x00\x00\x00l\x00\x00\x04:\x00\x00\x02k\x00\x00\x00\x00\x00\x00\x00\x00\x05V\x00\x00\x01\x1b\x00\x00\x00l\x00\x00\x04:\x00\x00\x02k', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\ndomain = Domain([ContinuousVariable("age"),\n                 ContinuousVariable("height"),\n                 DiscreteVariable("gender", values=("M", "F"))])\narr = np.array([\n  [25, 186, 0],\n  [30, 164, 1]])\nout_data = Table.from_numpy(domain, arr)\n', 'filename': None}], 'scriptText': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\ndomain = Domain([ContinuousVariable("age"),\n                 ContinuousVariable("height"),\n                 DiscreteVariable("gender", values=("M", "F"))])\narr = np.array([\n  [25, 186, 0],\n  [30, 164, 1]])\nout_data = Table.from_numpy(domain, arr)\n\nimport re\nfrom collections import Counter\n\nout_data = in_data.copy()\n\n# PASO 1 — Extraer los 4 dígitos del medio\nfor i, row in enumerate(out_data):\n    valor = str(row["codigo_postal_dest"]).strip().upper()\n    numeros = re.search(r\'\\d{4}\', valor)\n    out_data[i]["codigo_postal_dest"] = numeros.group() if numeros else ""\n\n# PASO 2 — Construir moda por provincia (datos ya limpios)\nprovincia_a_codigos = {}\nfor row in out_data:\n    provincia = str(row["provincia_destino"]).strip()\n    codigo = str(row["codigo_postal_dest"]).strip()\n    if codigo and codigo not in ("", "?", "None", "nan"):\n        provincia_a_codigos.setdefault(provincia, []).append(codigo)\n\nprovincia_a_moda = {\n    prov: Counter(cods).most_common(1)[0][0]\n    for prov, cods in provincia_a_codigos.items()\n}\n\n# PASO 3 — Rellenar vacíos con la moda de su provincia\nfor i, row in enumerate(out_data):\n    codigo = str(row["codigo_postal_dest"]).strip()\n    if codigo in ("", "?", "None", "nan"):\n        provincia = str(row["provincia_destino"]).strip()\n        out_data[i]["codigo_postal_dest"] = provincia_a_moda.get(provincia, "0000")\n\nprint(f"✅ Listo. Filas procesadas: {len(out_data)}")\nprint(f"📍 Provincias: {list(provincia_a_moda.keys())}")', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\x9f\x00\x00\x00`\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
