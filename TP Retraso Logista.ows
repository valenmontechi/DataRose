		<properties node_id="27" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x01\x1a\x00\x00\x00M\x00\x00\x04&lt;\x00\x00\x02l\x00\x00\x01\x1b\x00\x00\x00l\x00\x00\x04;\x00\x00\x02k\x00\x00\x00\x00\x00\x00\x00\x00\x05V\x00\x00\x01\x1b\x00\x00\x00l\x00\x00\x04;\x00\x00\x02k', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\ndomain = Domain([ContinuousVariable("age"),\n                 ContinuousVariable("height"),\n                 DiscreteVariable("gender", values=("M", "F"))])\narr = np.array([\n  [25, 186, 0],\n  [30, 164, 1]])\nout_data = Table.from_numpy(domain, arr)\n', 'filename': None}], 'scriptText': 'import numpy as np\nfrom Orange.data import Table, Domain, StringVariable, DiscreteVariable, ContinuousVariable\n\nSEED = 42\nnp.random.seed(SEED)\n\nclass_values = in_data.domain.class_var.values\nprint(f"Clases encontradas: {class_values}")\n\nclase_mayoritaria = class_values[0]\nclase_minoritaria = class_values[1]\n\nvals = np.array([str(inst.get_class()) for inst in in_data])\nidx_0 = np.where(vals == clase_mayoritaria)[0]\nidx_1 = np.where(vals == clase_minoritaria)[0]\n\nn_majority = len(idx_0)\nn_minority = len(idx_1)\n\nprint(f"ORIGINAL → \'{clase_mayoritaria}\': {n_majority} | \'{clase_minoritaria}\': {n_minority} | Ratio: {n_majority/n_minority:.1f}:1")\n\nTARGET_RATIO = 0.65\nn_class1_target = int(n_majority * (1 - TARGET_RATIO) / TARGET_RATIO)\nn_needed = max(0, n_class1_target - n_minority)\n\nprint(f"A generar: {n_needed} sintéticos de \'{clase_minoritaria}\'")\n\ndomain = in_data.domain\nminority_table = in_data[idx_1]\nX_min = minority_table.X\nY_min = minority_table.Y\n\ncontinuous_mask = np.array([attr.is_continuous for attr in domain.attributes])\n\nprint(f"Numéricas: {[a.name for a in domain.attributes if a.is_continuous]}")\nprint(f"Categóricas: {[a.name for a in domain.attributes if not a.is_continuous]}")\n\n# Detectar columnas numéricas que deben ser enteros\n# (las que en los datos originales no tienen decimales)\ninteger_mask = np.zeros(len(domain.attributes), dtype=bool)\nfor k, attr in enumerate(domain.attributes):\n    if attr.is_continuous:\n        col = X_min[:, k]\n        col_clean = col[~np.isnan(col)]\n        if np.all(col_clean == col_clean.astype(int)):\n            integer_mask[k] = True\n            print(f"  → \'{attr.name}\' se redondeará a entero")\n\n# Generar sintéticos\nsynthetic_X = []\nmeta_source_indices = []\n\nfor _ in range(n_needed):\n    i, j = np.random.choice(len(minority_table), size=2, replace=False)\n    alpha = np.random.random()\n    nuevo = X_min[i].copy()\n\n    nuevo[continuous_mask] = (X_min[i][continuous_mask] * alpha +\n                               X_min[j][continuous_mask] * (1 - alpha))\n    nuevo[~continuous_mask] = (X_min[i][~continuous_mask] if alpha &gt; 0.5\n                                else X_min[j][~continuous_mask])\n\n    # Redondear columnas que deben ser enteras\n    nuevo[integer_mask] = np.round(nuevo[integer_mask]).astype(float)\n\n    synthetic_X.append(nuevo)\n    meta_source_indices.append(i if alpha &gt; 0.5 else j)\n\nsynthetic_X = np.array(synthetic_X)\nY_synthetic = np.full(n_needed, Y_min[0])\n\n# Metas: copiar de instancias originales (respeta strings)\nif domain.metas:\n    M_synthetic = np.array([minority_table.metas[k]\n                             for k in meta_source_indices])\nelse:\n    M_synthetic = None\n\n# -----------------------------------------------\n# Agregar columna "origen" como meta string\norigen_var = StringVariable("origen")\nnew_metas = list(domain.metas) + [origen_var]\nnew_domain = Domain(domain.attributes, domain.class_var, new_metas)\n\n# Datos originales: agregar "original" en la columna origen\nn_original = len(in_data)\nif domain.metas:\n    metas_originales = np.hstack([\n        in_data.metas,\n        np.array([["original"]] * n_original)\n    ])\nelse:\n    metas_originales = np.array([["original"]] * n_original)\n\noriginal_table = Table.from_numpy(\n    new_domain,\n    in_data.X,\n    in_data.Y,\n    metas_originales\n)\n\n# Datos sintéticos: agregar "sintetico" en la columna origen\nif domain.metas:\n    metas_sinteticas = np.hstack([\n        M_synthetic,\n        np.array([["sintetico"]] * n_needed)\n    ])\nelse:\n    metas_sinteticas = np.array([["sintetico"]] * n_needed)\n\nsynthetic_table = Table.from_numpy(\n    new_domain,\n    synthetic_X,\n    Y_synthetic,\n    metas_sinteticas\n)\n\n# Combinar y mezclar\ncombined = Table.concatenate([original_table, synthetic_table])\nindices = np.random.permutation(len(combined))\nout_data = combined[indices]\n\nvals_final = np.array([str(inst.get_class()) for inst in out_data])\nprint(f"FINAL → \'{clase_mayoritaria}\': {np.sum(vals_final==clase_mayoritaria)} | \'{clase_minoritaria}\': {np.sum(vals_final==clase_minoritaria)} | Total: {len(out_data)}")\nprint(f"Columna \'origen\' agregada: \'original\' o \'sintetico\'")\n\n', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\x9f\x00\x00\x00`\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
